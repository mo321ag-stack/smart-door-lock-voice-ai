<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="14.0">
  <PropertyGroup>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>7.0</ProjectVersion>
    <ToolchainName>com.Atmel.AVRGCC8.C</ToolchainName>
    <ProjectGuid>{6B1F6A2E-3C5D-4E8A-9B7C-2D4E6F8A0B13}</ProjectGuid>
    <avrdevice>ATmega32</avrdevice>
    <avrdeviceseries>none</avrdeviceseries>
    <OutputType>Executable</OutputType>
    <Language>C</Language>
    <OutputFileName>$(MSBuildProjectName)</OutputFileName>
    <OutputFileExtension>.elf</OutputFileExtension>
    <OutputDirectory>$(MSBuildProjectDirectory)\..\$(Configuration)</OutputDirectory>
    <AssemblyName>SmartDoorLock</AssemblyName>
    <Name>SmartDoorLock</Name>
    <RootNamespace>SmartDoorLock</RootNamespace>
    <ToolchainFlavour>Native</ToolchainFlavour>
    <KeepTimersRunning>true</KeepTimersRunning>
    <OverrideVtor>false</OverrideVtor>
    <CacheFlash>true</CacheFlash>
    <ProgFlashFromRam>true</ProgFlashFromRam>
    <RamSnippetAddress />
    <UncachedRange />
    <preserveEEPROM>true</preserveEEPROM>
    <OverrideVtorValue />
    <BootSegment>2</BootSegment>
    <ResetRule>0</ResetRule>
    <eraseonlaunchrule>0</eraseonlaunchrule>
    <EraseKey />
    <avrtool />
    <avrtoolserialnumber />
    <avrdeviceexpectedsignature>0x1E9502</avrdeviceexpectedsignature>
    <AsfFrameworkConfig>
      <framework-data xmlns="">
        <options />
        <configurations />
        <files />
        <documentation help="" />
        <offline-documentation help="" />
        <dependencies>
          <content-extension eid="atmel.asf" uuid="Atmel.ASF" version="3.52.0" />
        </dependencies>
      </framework-data>
    </AsfFrameworkConfig>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ToolchainSettings>
      <AvrGcc>
        <avrgcc.common.Device>-mmcu=atmega32</avrgcc.common.Device>
        <avrgcc.common.outputfiles.hex>True</avrgcc.common.outputfiles.hex>
        <avrgcc.common.outputfiles.lss>True</avrgcc.common.outputfiles.lss>
        <avrgcc.common.outputfiles.eep>True</avrgcc.common.outputfiles.eep>
        <avrgcc.common.outputfiles.srec>False</avrgcc.common.outputfiles.srec>
        <avrgcc.common.outputfiles.usersignatures>False</avrgcc.common.outputfiles.usersignatures>
        <avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>True</avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>
        <avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>True</avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>
        <avrgcc.compiler.symbols.DefSymbols>
          <ListValues>
            <Value>F_CPU=8000000UL</Value>
          </ListValues>
        </avrgcc.compiler.symbols.DefSymbols>
        <avrgcc.compiler.directories.IncludePaths>
          <ListValues>
            <Value>../../Headers</Value>
          </ListValues>
        </avrgcc.compiler.directories.IncludePaths>
        <avrgcc.compiler.optimization.level>Optimize for size (-Os)</avrgcc.compiler.optimization.level>
        <avrgcc.compiler.optimization.PrepareFunctionsForGarbageCollection>True</avrgcc.compiler.optimization.PrepareFunctionsForGarbageCollection>
        <avrgcc.compiler.optimization.PrepareDataForGarbageCollection>True</avrgcc.compiler.optimization.PrepareDataForGarbageCollection>
        <avrgcc.compiler.optimization.PackStructureMembers>True</avrgcc.compiler.optimization.PackStructureMembers>
        <avrgcc.compiler.optimization.AllocateBytesNeededForEnum>True</avrgcc.compiler.optimization.AllocateBytesNeededForEnum>
        <avrgcc.compiler.optimization.DebugLevel>Default (-g2)</avrgcc.compiler.optimization.DebugLevel>
        <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
        <avrgcc.compiler.warnings.ExtraWarnings>True</avrgcc.compiler.warnings.ExtraWarnings>
        <avrgcc.compiler.miscellaneous.OtherFlags>-std=gnu99</avrgcc.compiler.miscellaneous.OtherFlags>
        <avrgcc.linker.general.GarbageCollectUnusedSections>True</avrgcc.linker.general.GarbageCollectUnusedSections>
        <avrgcc.linker.libraries.Libraries>
          <ListValues>
            <Value>libm</Value>
          </ListValues>
        </avrgcc.linker.libraries.Libraries>
      </AvrGcc>
    </ToolchainSettings>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ToolchainSettings>
      <AvrGcc>
        <avrgcc.common.Device>-mmcu=atmega32</avrgcc.common.Device>
        <avrgcc.common.outputfiles.hex>True</avrgcc.common.outputfiles.hex>
        <avrgcc.common.outputfiles.lss>True</avrgcc.common.outputfiles.lss>
        <avrgcc.common.outputfiles.eep>True</avrgcc.common.outputfiles.eep>
        <avrgcc.common.outputfiles.srec>False</avrgcc.common.outputfiles.srec>
        <avrgcc.common.outputfiles.usersignatures>False</avrgcc.common.outputfiles.usersignatures>
        <avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>True</avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>
        <avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>True</avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>
        <avrgcc.compiler.symbols.DefSymbols>
          <ListValues>
            <Value>F_CPU=8000000UL</Value>
            <Value>NDEBUG</Value>
          </ListValues>
        </avrgcc.compiler.symbols.DefSymbols>
        <avrgcc.compiler.directories.IncludePaths>
          <ListValues>
            <Value>../../Headers</Value>
          </ListValues>
        </avrgcc.compiler.directories.IncludePaths>
        <avrgcc.compiler.optimization.level>Optimize for size (-Os)</avrgcc.compiler.optimization.level>
        <avrgcc.compiler.optimization.PrepareFunctionsForGarbageCollection>True</avrgcc.compiler.optimization.PrepareFunctionsForGarbageCollection>
        <avrgcc.compiler.optimization.PrepareDataForGarbageCollection>True</avrgcc.compiler.optimization.PrepareDataForGarbageCollection>
        <avrgcc.compiler.optimization.PackStructureMembers>True</avrgcc.compiler.optimization.PackStructureMembers>
        <avrgcc.compiler.optimization.AllocateBytesNeededForEnum>True</avrgcc.compiler.optimization.AllocateBytesNeededForEnum>
        <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
        <avrgcc.compiler.warnings.ExtraWarnings>True</avrgcc.compiler.warnings.ExtraWarnings>
        <avrgcc.compiler.miscellaneous.OtherFlags>-std=gnu99</avrgcc.compiler.miscellaneous.OtherFlags>
        <avrgcc.linker.general.GarbageCollectUnusedSections>True</avrgcc.linker.general.GarbageCollectUnusedSections>
        <avrgcc.linker.libraries.Libraries>
          <ListValues>
            <Value>libm</Value>
          </ListValues>
        </avrgcc.linker.libraries.Libraries>
      </AvrGcc>
    </ToolchainSettings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Source\main.c"><SubType>compile</SubType><Link>Source\main.c</Link></Compile>
    <Compile Include="..\Source\authentication.c"><SubType>compile</SubType><Link>Source\authentication.c</Link></Compile>
    <Compile Include="..\Source\protocol.c"><SubType>compile</SubType><Link>Source\protocol.c</Link></Compile>
    <Compile Include="..\Source\uart.c"><SubType>compile</SubType><Link>Source\uart.c</Link></Compile>
    <Compile Include="..\Source\i2c.c"><SubType>compile</SubType><Link>Source\i2c.c</Link></Compile>
    <Compile Include="..\Source\lcd_i2c.c"><SubType>compile</SubType><Link>Source\lcd_i2c.c</Link></Compile>
    <Compile Include="..\Source\keypad.c"><SubType>compile</SubType><Link>Source\keypad.c</Link></Compile>
    <Compile Include="..\Source\servo.c"><SubType>compile</SubType><Link>Source\servo.c</Link></Compile>
    <Compile Include="..\Source\timebase.c"><SubType>compile</SubType><Link>Source\timebase.c</Link></Compile>
    <Compile Include="..\Source\diagnostics.c"><SubType>compile</SubType><Link>Source\diagnostics.c</Link></Compile>
    <Compile Include="..\Headers\config.h"><SubType>compile</SubType><Link>Headers\config.h</Link></Compile>
    <Compile Include="..\Headers\authentication.h"><SubType>compile</SubType><Link>Headers\authentication.h</Link></Compile>
    <Compile Include="..\Headers\protocol.h"><SubType>compile</SubType><Link>Headers\protocol.h</Link></Compile>
    <Compile Include="..\Headers\uart.h"><SubType>compile</SubType><Link>Headers\uart.h</Link></Compile>
    <Compile Include="..\Headers\i2c.h"><SubType>compile</SubType><Link>Headers\i2c.h</Link></Compile>
    <Compile Include="..\Headers\lcd_i2c.h"><SubType>compile</SubType><Link>Headers\lcd_i2c.h</Link></Compile>
    <Compile Include="..\Headers\keypad.h"><SubType>compile</SubType><Link>Headers\keypad.h</Link></Compile>
    <Compile Include="..\Headers\servo.h"><SubType>compile</SubType><Link>Headers\servo.h</Link></Compile>
    <Compile Include="..\Headers\timebase.h"><SubType>compile</SubType><Link>Headers\timebase.h</Link></Compile>
    <Compile Include="..\Headers\diagnostics.h"><SubType>compile</SubType><Link>Headers\diagnostics.h</Link></Compile>
  </ItemGroup>
  <Import Project="$(AVRSTUDIO_EXE_PATH)\\Vs\\Compiler.targets" />
</Project>
